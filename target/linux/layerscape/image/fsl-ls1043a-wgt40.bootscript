# assumes environment variables:
# 'bootdev' - boot device to load from, e.g. 'usb' or 'scsi'. assumes boot from first device, first partition
# 'rootpart' - root partition to pass to kernel, e.g. '/dev/sdb1'

env set fit_addr_r 0x94000000

echo "Booting from ${bootdev}..."
led off

env set bootargs console=ttyS0,115200 earlycon=uart8250,mmio,0x21c0500 root=${rootpart} rw rootwait

load ${bootdev} 0:1 ${fit_addr_r} /kernel.itb
bootm ${fit_addr_r}
